# Start with: python -m oni_web (PYTHONPATH=backend + backend/vendor; see README).
ONI_WEB_HOST=127.0.0.1
ONI_WEB_PORT=8000
ONI_WEB_DATA_DIR=./data

# Required when listening outside loopback. Use a long random token.
ONI_WEB_TOKEN=
# Comma-separated exact browser origins. Include the Vite origin during development.
ONI_WEB_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
# Set true behind an HTTPS reverse proxy. Never expose the app over public HTTP.
ONI_WEB_SECURE_COOKIE=false
# Fernet key; generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, an owner-only key is created under ONI_WEB_DATA_DIR. Back up it AND vault.enc.
ONI_WEB_ENCRYPTION_KEY=
ONI_WEB_COMMANDS_PER_MINUTE=180
ONI_WEB_MAX_INFLIGHT=16
ONI_WEB_ALLOW_DEMO=true
# Optional: build native/Cargo.toml, then opt into game provisioning and SSH discovery.
# Use an absolute executable path; never configure this from browser input.
ONI_WEB_NATIVE_HELPER=

# Optional trusted oni-rcon TOML import, performed once into the encrypted vault.
# password_command / health_cmd / restart_cmd run ONLY from this operator-owned file.
ONI_RCON_CONFIG=
ONI_RCON_PASSWORD=
RECLAIMERFORGE_API_KEY=
